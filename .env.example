# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cookie session secret (any random 32+ char string)
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# football-data.org — free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-api-key
FOOTBALL_DATA_COMPETITION=WC

# Cron protection — Vercel sets x-vercel-cron header automatically; we also accept ?secret=
CRON_SECRET=replace-with-another-random-string
